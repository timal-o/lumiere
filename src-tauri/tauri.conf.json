{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumière",
  "version": "0.6.2",
  "identifier": "io.github.timal-o.lumiere",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumière",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "lum"
        ],
        "name": "Lumière project",
        "role": "Editor",
        "mimeType": "application/x-lumiere"
      },
      {
        "ext": [
          "lbrn",
          "lbrn2"
        ],
        "name": "LightBurn project",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
